  "license": "MIT",
  "author": "Attested Intelligence Holdings LLC",
  "homepage": "https://attestedintelligence.com/technology",
  "keywords": [
    "aga",
    "evidence-bundle",
    "verifier",
    "ed25519",
    "merkle",
    "offline-verification",
    "attested-intelligence",
    "ai-governance"
  ],
  "bin": {
    "aga-verify": "dist/aga-verify.mjs"
  },
  "files": [
